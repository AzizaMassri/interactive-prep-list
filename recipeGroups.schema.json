{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interactive Prep List",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "properties": {
      "group": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "recipes": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "recipe": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "yield": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "completed": {
              "type": "boolean"
            },
            "ingredients": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "quantity": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "type": "string",
                    "enum": [
                      "g",
                      "kg",
                      "ml",
                      "L",
                      "oz",
                      "lb",
                      "c",
                      "pt",
                      "qt",
                      "gal",
                      "tsp",
                      "tbsp",
                      "ea",
                      "bu",
                      "head",
                      "cs",
                      "dz"
                    ]
                  }
                },
                "required": [
                  "name",
                  "quantity",
                  "unit"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "recipe",
            "yield",
            "ingredients"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "group",
      "recipes"
    ],
    "additionalProperties": false
  }
}